############################################
# AMBIENTE GERAL
############################################
ENVIRONMENT=production
APP_NAME=TAGOCP_IA
APP_VERSION=1.0.0
APP_DEBUG=false
TIMEZONE=America/Sao_Paulo
LANGUAGE=pt-BR


############################################
# SEGURANÇA / JWT
############################################
JWT_SECRET_KEY=troque_essa_chave_jwt_por_uma_bem_longa_e_segura
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


############################################
# CRIPTOGRAFIA (OBRIGATÓRIO)
############################################
# 32 bytes recomendados
CRYPTO_MASTER_KEY=troque_essa_master_key_por_uma_muito_segura_32bytes


############################################
# BANCO DE DADOS
############################################
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tagocp_ia
DATABASE_USER=tagocp_user
DATABASE_PASSWORD=troque_essa_senha_do_banco


############################################
# OPENAI / LLM REAL
############################################
OPENAI_API_KEY=sk-coloque_sua_chave_real_aqui
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1024
OPENAI_TIMEOUT=60


############################################
# RAG + FAISS
############################################
RAG_ENABLED=true
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

FAISS_INDEX_PATH=data/faiss/index.bin
FAISS_METADATA_PATH=data/faiss/metadata.pkl
PDF_ARTICLES_PATH=data/artigos


############################################
# ADMINISTRADOR
############################################
ADMIN_EMAIL=admin@tagocp.ai
ADMIN_DEFAULT_PASSWORD=troque_essa_senha_admin
ADMIN_DASHBOARD_ENABLED=true


############################################
# LGPD / COMPLIANCE
############################################
LGPD_ENABLED=true
LGPD_TERMS_VERSION=1.0
LGPD_REQUIRE_ACCEPTANCE=true
LGPD_LOG_CONSENT=true
LGPD_DATA_RETENTION_DAYS=730
LGPD_DPO_EMAIL=dpo@tagocp.ai


############################################
# SUPORTE EM CRISE
############################################
CRISIS_SUPPORT_ENABLED=true
CRISIS_PHONE_BR=188
CRISIS_PROVIDER=CVV
CRISIS_AUTO_TRIGGER=true


############################################
# LOGS E MÉTRICAS
############################################
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
METRICS_ENABLED=true
METRICS_RETENTION_DAYS=365
